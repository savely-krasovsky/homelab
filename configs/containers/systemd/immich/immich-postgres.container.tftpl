[Unit]
Description=Immich Postgres Quadlet

[Container]
Image=ghcr.io/immich-app/postgres:17-vectorchord0.5.3
AutoUpdate=registry
ContainerName=immich-postgres

User=1000:1000

Environment=POSTGRES_USER=immich
Environment=POSTGRES_DB=immich
Environment=POSTGRES_INITDB_ARGS="--data-checksums"
Secret=immich-postgres-password,type=env,target=POSTGRES_PASSWORD

Label="glance.parent=immich"
Label="glance.name=Postgres"
Label="glance.hide=false"

# Every cluster runs with data checksums: fail the health check on any checksum failure, not only on connection errors.
HealthCmd=pg_isready --host=127.0.0.1 --dbname="$$${POSTGRES_DB}" --username="$$${POSTGRES_USER}" || exit 1; \
        Chksum="$(psql --dbname="$$${POSTGRES_DB}" --username="$$${POSTGRES_USER}" --tuples-only --no-align \
        --command='SELECT COALESCE(SUM(checksum_failures), 0) FROM pg_stat_database')"; \
        echo "checksum failure count is $Chksum"; \
        [ "$Chksum" = '0' ] || exit 1
HealthInterval=5s

# The Immich image is still PostgreSQL 17, whose data directory lives one level deeper than in 18.
Volume=/var/mnt/docker/app_data/immich/postgres:/var/lib/postgresql/data:Z

Pod=immich.pod
Notify=healthy

[Service]
TimeoutStartSec=900
Restart=always

[Install]
WantedBy=multi-user.target default.target
