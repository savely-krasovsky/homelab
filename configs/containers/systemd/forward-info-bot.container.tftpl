[Unit]
Description=Forward Info Bot Quadlet

[Container]
Image=ghcr.io/savely-krasovsky/forward-info-bot:latest@sha256:cfc790f7378cb9ce9d1dc604840a06c09700771c1631b4107c9b67bcbaaa9e85
AutoUpdate=registry
ContainerName=forward-info-bot

Secret=forward-info-bot-telegram-token,type=env,target=FORWARD_INFO_BOT_TELEGRAM_TOKEN

Network=reverse-proxy.network

[Service]
TimeoutStartSec=900
Restart=always

[Install]
WantedBy=multi-user.target default.target
