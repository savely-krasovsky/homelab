# Copy this file to terraform.tfvars, replace every example value, and run:
# chmod 600 terraform.tfvars

bws_access_token = "replace-with-bitwarden-machine-access-token"

site_config = {
  email       = "admin@example.com"
  base_domain = "example.com"
  ews_domain  = "mail.example.com"
}

network_config = {
  public_ip        = "203.0.113.10"
  gateway_ip       = "192.0.2.1"
  dns_ip           = "192.0.2.1"
  pve_ip           = "192.0.2.10"
  fcos_ip          = "192.0.2.20"
  pbs_ip           = "192.0.2.40" # External PBS; no VM management.
  fcos_mac_address = "02:00:00:00:00:10"
  subnet_prefix    = 24
  bridge           = "vmbr0"
  vlan_id          = 100
}

proxmox_config = {
  endpoint  = "https://pve.lan.example.com:8006"
  node_name = "pve"
}

fcos_config = {
  stream   = "stable"
  hostname = "fcos"
  root_ca  = "replace-with-PEM-encoded-root-CA"

  ssh_authorized_keys = {
    admin = [
      "ssh-ed25519 replace-with-admin-public-key",
    ]
    applications = [
      "ssh-ed25519 replace-with-application-deployment-public-key",
    ]
  }

  storage = {
    data_device  = "/dev/zvol/spool/docker"
    data_pv_uuid = "AAAAAA-BBBB-CCCC-DDDD-EEEE-FFFF-GGGGGG" # Existing PV, not a new UUID.
    shares = {
      media         = "/mnt/spool/media"
      personal      = "/mnt/spool/personal"
      observability = "/mnt/spool/observability"
    }
  }
}

deployment_config = {
  ssh_private_key_path = "/home/user/.ssh/homelab-deployment"
}

secret_config = {
  proxmox_password = {
    id = "replace-with-proxmox-password-bitwarden-secret-id"
  }
  proxmox_acme_cloudflare_token = {
    id       = "replace-with-proxmox-acme-bitwarden-secret-id"
    revision = 1
  }
  podman = {
    "actual-openid-client-secret" = { id = "replace-with-actual-openid-client-secret-bitwarden-secret-id" }
    "coturn-turn-shared-secret" = { id = "replace-with-coturn-turn-shared-secret-bitwarden-secret-id" }
    "crowdsec-auth-oidc-client-secret" = { id = "replace-with-crowdsec-auth-oidc-client-secret-bitwarden-secret-id" }
    "crowdsec-lapi-password" = { id = "replace-with-crowdsec-lapi-password-bitwarden-secret-id" }
    "forward-info-bot-telegram-token" = { id = "replace-with-forward-info-bot-telegram-token-bitwarden-secret-id" }
    "glance-github-token" = { id = "replace-with-glance-github-token-bitwarden-secret-id" }
    "grafana-oauth2-client-secret" = { id = "replace-with-grafana-oauth2-client-secret-bitwarden-secret-id" }
