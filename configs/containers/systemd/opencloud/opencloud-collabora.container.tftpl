[Unit]
PartOf=opencloud.target
Description=OpenCloud Collabora Quadlet

[Container]
Image=docker.io/collabora/code:26.04.4.1.1
ContainerName=opencloud-collabora

Environment=aliasgroup1=https://wopiserver.${base_domain}:443
Environment=username=admin
Environment=DONT_GEN_SSL_CERT=YES
Environment=extra_params="--o:ssl.enable=false --o:ssl.ssl_verification=false --o:ssl.termination=true --o:server_name=collabora.${base_domain} --o:hexify_embedded_urls=true --o:welcome.enable=false --o:net.frame_ancestors=cloud.${base_domain}"
Secret=opencloud-collabora-password,type=env,target=password
Secret=opencloud-collabora-proof-key,type=mount,target=/etc/coolwsd/proof_key,uid=1001,gid=1001,mode=0600

Label="glance.parent=opencloud"
Label="glance.name=Collabora"
Label="glance.hide=false"

Label="traefik.enable=true"
Label="traefik.http.routers.collabora.rule=Host(`collabora.${base_domain}`)"
Label="traefik.http.routers.collabora.service=collabora"
Label="traefik.http.services.collabora.loadbalancer.server.port=9980"

# Collaboration starts after Collabora passes its image health check.
HealthInterval=30s
HealthStartPeriod=1m
Notify=healthy

Pod=opencloud.pod

AddCapability=MKNOD

[Service]
ExecStartPre=/usr/bin/mountpoint -q /var/mnt/docker
TimeoutStartSec=900
Restart=always
MemoryHigh=2G
MemoryMax=3G
