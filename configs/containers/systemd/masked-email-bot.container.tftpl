[Unit]
Requires=reverse-proxy-network.service
After=reverse-proxy-network.service
Description=Masked Email Bot Quadlet

[Container]
Image=ghcr.io/savely-krasovsky/masked-email-bot:latest@sha256:d57ee335937b912939b747115942f66ceca7462c49d2f26ead90c2e57455c487
ContainerName=masked-email-bot

User=1000:1000
UserNS=keep-id:uid=1000,gid=1000

Environment=FASTMAIL_OAUTH2_CLIENT_ID=354141ae
Environment=FASTMAIL_OAUTH2_REDIRECT_URL=https://maskedemailbot.${base_domain}/redirect
Secret=masked-email-bot-telegram-token,type=env,target=TELEGRAM_TOKEN

Label="traefik.enable=true"
Label="traefik.http.routers.masked-email-bot.rule=Host(`maskedemailbot.${base_domain}`)"
Label="traefik.http.services.masked-email-bot.loadbalancer.server.port=8080"

Volume=/var/mnt/docker/app_data/masked-email-bot:/data:Z

Network=systemd-reverse-proxy

[Service]
ExecStartPre=/usr/bin/mountpoint -q /var/mnt/docker
ExecStartPre=/usr/bin/test -d /var/mnt/docker/app_data
ExecStartPre=/usr/bin/mkdir -p -m 0755 -- /var/mnt/docker/app_data/masked-email-bot
TimeoutStartSec=900
Restart=always

[Install]
WantedBy=multi-user.target default.target
