[Unit]
Requires=reverse-proxy-network.service
After=reverse-proxy-network.service
Description=RMQTT Broker Quadlet

[Container]
Image=docker.io/rmqtt/rmqtt:0.23.1
ContainerName=rmqtt

User=1000:1000
UserNS=keep-id:uid=1000,gid=1000

Label="glance.parent=victoria-metrics"
Label="glance.name=MQTT Broker"
Label="glance.hide=false"

Label="alloy.metrics.enable=true"
Label="alloy.metrics.port=6060"
Label="alloy.metrics.path=/api/v1/metrics/prometheus"

Volume=/var/mnt/docker/app_data/rmqtt/logs:/var/log/rmqtt:Z
Volume=/dev/null:/var/log/rmqtt/hook.log

Network=systemd-reverse-proxy
PublishPort=1883:1883
PublishPort=6060:6060

[Service]
ExecStartPre=/usr/bin/mountpoint -q /var/mnt/docker
ExecStartPre=/usr/bin/test -d /var/mnt/docker/app_data
ExecStartPre=/usr/bin/mkdir -p -m 0755 -- /var/mnt/docker/app_data/rmqtt/logs
TimeoutStartSec=900
Restart=always

[Install]
WantedBy=multi-user.target default.target
