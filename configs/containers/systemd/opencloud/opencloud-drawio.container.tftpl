[Unit]
PartOf=opencloud.target
Description=OpenCloud Draw.io Extension Quadlet

[Container]
Image=docker.io/opencloudeu/web-extensions:draw-io-latest
# The daily timer reruns this oneshot; keep cached assets usable when offline.
Pull=newer
ContainerName=opencloud-drawio

User=1000:1000

Entrypoint=/bin/sh
Exec=-c "cp -R /usr/share/nginx/html/apps/draw-io/ /apps"

Volume=opencloud-apps.volume:/apps

Pod=opencloud.pod

[Service]
ExecStartPre=/usr/bin/mountpoint -q /var/mnt/docker
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=900
