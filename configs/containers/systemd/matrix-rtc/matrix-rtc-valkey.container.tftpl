[Unit]
Description=MatrixRTC Valkey Quadlet

[Container]
Image=docker.io/valkey/valkey:9-alpine
AutoUpdate=registry
ContainerName=matrix-rtc-valkey

User=1000:1000

Label="glance.parent=matrix-rtc"
Label="glance.name=Valkey"
Label="glance.hide=false"

HealthCmd=valkey-cli ping || exit 1

Volume=/var/mnt/docker/app_data/matrix-rtc/valkey:/data:Z

Pod=matrix-rtc.pod
Notify=healthy

[Service]
ExecStartPre=/usr/bin/mountpoint -q /var/mnt/docker
ExecStartPre=/usr/bin/test -d /var/mnt/docker/app_data
ExecStartPre=/usr/bin/mkdir -p -m 0755 -- /var/mnt/docker/app_data/matrix-rtc/valkey
TimeoutStartSec=900
Restart=always
