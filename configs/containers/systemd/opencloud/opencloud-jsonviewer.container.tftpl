[Unit]
Description=OpenCloud JSON Viewer Extension Quadlet

[Container]
Image=docker.io/opencloudeu/web-extensions:json-viewer-latest
# The daily timer reruns this oneshot; keep cached assets usable when offline.
Pull=newer
ContainerName=opencloud-jsonviewer

User=1000:1000

Entrypoint=/bin/sh
Exec=-c "cp -R /usr/share/nginx/html/apps/json-viewer/ /apps"

Volume=opencloud-apps.volume:/apps

Pod=opencloud.pod

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target default.target
