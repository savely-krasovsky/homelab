[Unit]
Description=Crowdsec Quadlet

[Container]
Image=docker.io/crowdsecurity/crowdsec:v1.8.1
ContainerName=crowdsec-security-engine

User=1000:1000

Environment=COLLECTIONS=crowdsecurity/traefik
Environment=GID=1000
Secret=vmauth-crowdsec-bearer-token,type=env,target=VMAUTH_CROWDSEC_BEARER_TOKEN

Label="glance.name=Crowdsec"
Label="glance.icon=di:crowdsec"
Label="glance.url=https://crowdsec.${base_domain}"
Label="glance.description=Advanced Fail2ban"
Label="glance.hide=false"

Label="alloy.metrics.enable=true"
Label="alloy.metrics.port=6060"

Volume=/var/mnt/docker/app_data/crowdsec/data:/var/lib/crowdsec/data:Z
Volume=/var/mnt/docker/app_data/crowdsec/config:/etc/crowdsec:Z
# Override only acquisition; keep the existing identity, credentials and hub config.
Volume=%E/crowdsec/acquis.yaml:/etc/crowdsec/acquis.yaml:ro,Z
Volume=/var/mnt/docker/app_data/crowdsec/staging:/staging:Z

Pod=crowdsec.pod

[Service]
ExecStartPre=/usr/bin/mountpoint -q /var/mnt/docker
ExecStartPre=/usr/bin/test -d /var/mnt/docker/app_data
ExecStartPre=/usr/bin/mkdir -p -m 0755 -- /var/mnt/docker/app_data/crowdsec/data /var/mnt/docker/app_data/crowdsec/config /var/mnt/docker/app_data/crowdsec/staging
TimeoutStartSec=900
Restart=always
