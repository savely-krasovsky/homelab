[Unit]
Description=Hister llama.cpp Embeddings Quadlet

[Container]
Image=ghcr.io/ggml-org/llama.cpp:server-intel@sha256:49faa953135605c4664bf0771e92f10ef6ac89c2f4b2df5dbe0b8b1a9f720148
ContainerName=hister-llamacpp

User=1000:1000
GroupAdd=keep-groups

Environment=LLAMA_CACHE=/models

Label="glance.parent=hister"
Label="glance.name=Embeddings"
Label="glance.description=Qwen3 Embedding 0.6B on Intel Arc"

Label="alloy.metrics.enable=true"
Label="alloy.metrics.port=8080"

Volume=/var/mnt/docker/app_data/hister/llamacpp:/models:Z

AddDevice=/dev/dri

Pod=hister.pod

Exec=--hf-repo Qwen/Qwen3-Embedding-0.6B-GGUF:F16 --embedding --pooling last --port 8080 --ctx-size 512 --parallel 2 --cache-ram 0 --metrics --log-jsonl

[Service]
TimeoutStartSec=900
Restart=always
MemoryHigh=3G
MemoryMax=4G

[Install]
WantedBy=multi-user.target default.target
