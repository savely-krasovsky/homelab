[Unit]
Description=Victoria Logs Quadlet

[Container]
Image=docker.io/victoriametrics/victoria-logs:v1.52.0
ContainerName=victoria-logs

User=1000:1000

Label="glance.name=VictoriaLogs"
Label="glance.icon=di:victorialogs"
Label="glance.url=https://logs.${base_domain}"
Label="glance.description=Logs Storage"
Label="glance.hide=false"

Exec=--loggerFormat=json --httpListenAddr=127.0.0.1:9428 --retentionPeriod=6M --retention.maxDiskSpaceUsageBytes=30GB --memory.allowedBytes=1500MB --storage.minFreeDiskSpaceBytes=32GB

Volume=/var/mnt/observability/logs:/victoria-logs-data:Z

Pod=victoria.pod

[Service]
ExecStartPre=/usr/bin/mountpoint -q /var/mnt/docker
TimeoutStartSec=900
Restart=always
MemoryHigh=2G
MemoryMax=3G
