[Unit]
PartOf=opencloud.target
Description=OpenCloud Unzip Extension Quadlet

[Container]
Image=docker.io/opencloudeu/web-extensions:unzip-2.2.3
ContainerName=opencloud-unzip

User=1000:1000

Entrypoint=/bin/sh
Exec=-c "cp -R /usr/share/nginx/html/apps/unzip/ /apps"

Volume=opencloud-apps.volume:/apps

Pod=opencloud.pod

[Service]
ExecStartPre=/usr/bin/mountpoint -q /var/mnt/docker
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=900
