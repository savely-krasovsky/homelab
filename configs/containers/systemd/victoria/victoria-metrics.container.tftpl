[Unit]
Description=Victoria Metrics Quadlet

[Container]
Image=docker.io/victoriametrics/victoria-metrics:v1.152.0
ContainerName=victoria-metrics

User=1000:1000

Label="glance.id=victoria-metrics"
Label="glance.name=VictoriaMetrics"
Label="glance.icon=di:victoriametrics-light"
Label="glance.url=https://metrics.${base_domain}"
Label="glance.description=Metrics Storage"
Label="glance.hide=false"

Label="alloy.metrics.enable=true"
Label="alloy.metrics.port=8428"

# Retention suffixes: a capital M means months, a lower case m means minutes and is rejected.
Exec=--loggerFormat=json --graphiteListenAddr=:2003 --retentionPeriod=6M --memory.allowedBytes=1000MB --storage.minFreeDiskSpaceBytes=16GB

Volume=/var/mnt/observability/metrics:/victoria-metrics-data:Z

Pod=victoria.pod

[Service]
ExecStartPre=/usr/bin/mountpoint -q /var/mnt/docker
TimeoutStartSec=900
Restart=always
MemoryHigh=1.5G
MemoryMax=2G
