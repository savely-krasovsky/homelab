[Unit]
Requires=reverse-proxy-network.service
After=reverse-proxy-network.service
Description=Prometheus Podman Exporter Quadlet
Wants=socket-proxy.service
After=socket-proxy.service

[Container]
Image=quay.io/navidys/prometheus-podman-exporter:v2.0.0
ContainerName=prometheus-podman-exporter

UserNS=keep-id:uid=65534

Environment=CONTAINER_HOST=unix:///run/socket-proxy/podman.sock

Label="alloy.metrics.enable=true"
Label="alloy.metrics.port=9882"

Exec=--collector.enable-all

Volume=%t/socket-proxy:/run/socket-proxy:ro,z

Network=systemd-reverse-proxy

[Service]
ExecStartPre=/usr/bin/mountpoint -q /var/mnt/docker
TimeoutStartSec=900
Restart=always

[Install]
WantedBy=multi-user.target default.target
