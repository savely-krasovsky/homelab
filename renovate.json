{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Belgrade",
  "prHourlyLimit": 0,
  "prConcurrentLimit": 10,
  "quadlet": {
    "managerFilePatterns": [
      "/.+\\.container$/",
      "/.+\\.container\\.tftpl$/",
      "/.+\\.image$/",
      "/.+\\.volume$/"
    ]
  },
  "packageRules": [
    {
      "description": "Rolling tags with no upstream releases: track by digest instead.",
      "matchManagers": [
        "quadlet"
      ],
      "matchPackageNames": [
        "ghcr.io/open-webui/pipelines",
        "ghcr.io/savely-krasovsky/forward-info-bot",
        "ghcr.io/savely-krasovsky/masked-email-bot"
      ],
      "pinDigests": true,
      "groupName": "rolling container digests"
    },
    {
      "description": "Batch routine container bumps into one reviewable PR.",
      "matchManagers": [
        "quadlet"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "container images (minor & patch)"
    },
    {
      "description": "Majors get their own PR — they need release notes read.",
      "matchManagers": [
        "quadlet"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": null
    },
    {
      "description": "Databases never move on their own.",
      "matchManagers": [
        "quadlet"
      ],
      "matchPackageNames": [
        "/postgres/",
        "/valkey/",
        "/meilisearch/"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "OpenTofu providers from main.tf.",
      "matchManagers": [
        "terraform"
      ],
      "groupName": "opentofu providers"
    },
    {
      "description": "atcr.io is the ATProto container registry — Renovate has no datasource for it, so every run reports a lookup failure. Bump tangled by hand.",
      "matchPackageNames": [
        "atcr.io/tangled.org/knot"
      ],
      "enabled": false
    },
    {
      "description": "Collabora restructures the image inside version-looking bumps; read the release notes before merging.",
      "matchPackageNames": [
        "docker.io/collabora/code"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "qBittorrent also ships libtorrent 2.x builds as 5.2.3-lt2-1. Semver ranks that suffix above 5.2.3-1, so Renovate would read a different build line as an upgrade.",
      "matchPackageNames": [
        "docker.io/qbittorrentofficial/qbittorrent-nox"
      ],
      "allowedVersions": "!/lt2/"
    },
    {
      "description": "Ignition verifies these tarballs by sha256 and Renovate cannot recompute it. A merged bump leaves the hash stale and the next rebuild dies in the initramfs, so these never open a PR on their own.",
      "matchManagers": [
        "custom.regex"
      ],
      "prBodyNotes": [
        "Update the `sha256-` hash next to this URL in `butane/fcos.yml.tftpl` in this PR.",
        "`curl -sL <url> | sha256sum` gives the value. Without it ignition fails at first boot, not at apply."
      ],
      "dependencyDashboardApproval": true
    }
  ],
  "customManagers": [
    {
      "description": "systemd_exporter tarball fetched by ignition; the version appears twice in the URL.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^butane/fcos\\.yml\\.tftpl$/"
      ],
      "matchStrings": [
        "https://github\\.com/(?<depName>prometheus\\-community/systemd_exporter)/releases/download/v(?<currentValue>[\\d.]+)/systemd_exporter-[\\d.]+\\.linux-amd64\\.tar\\.gz"
      ],
      "autoReplaceStringTemplate": "https://github.com/{{{depName}}}/releases/download/v{{{newValue}}}/systemd_exporter-{{{newValue}}}.linux-amd64.tar.gz",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    },
    {
      "description": "node_exporter tarball fetched by ignition; the version appears twice in the URL.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^butane/fcos\\.yml\\.tftpl$/"
      ],
      "matchStrings": [
        "https://github\\.com/(?<depName>prometheus/node_exporter)/releases/download/v(?<currentValue>[\\d.]+)/node_exporter-[\\d.]+\\.linux-amd64\\.tar\\.gz"
      ],
      "autoReplaceStringTemplate": "https://github.com/{{{depName}}}/releases/download/v{{{newValue}}}/node_exporter-{{{newValue}}}.linux-amd64.tar.gz",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    }
  ]
}
