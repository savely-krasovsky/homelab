variant: fcos
version: 1.5.0

passwd:
  groups:
    - name: homelab
      gid: 1000
    - name: core
      gid: 1001
  users:
    - name: core
      uid: 1001
      primary_group: core
      ssh_authorized_keys:
%{ for _, ssh_key in ssh_keys ~}
        - ${ssh_key}
%{ endfor ~}
    - name: homelab
      # Stable identity for application data and VirtIO-FS ownership.
      uid: 1000
      primary_group: homelab
      home_dir: /var/home/homelab
      shell: /bin/bash
      groups:
        - systemd-journal
      ssh_authorized_keys:
%{ for _, ssh_key in homelab_ssh_keys ~}
        - ${ssh_key}
%{ endfor ~}

storage:
  directories:
    # Config dir
    - path: /var/home/homelab/.config
      user:
        name: homelab
      group:
        name: homelab

    # Systemd user dir
    - path: /var/home/homelab/.config/containers
      user:
        name: homelab
      group:
        name: homelab
    - path: /var/home/homelab/.config/systemd
      user:
        name: homelab
      group:
        name: homelab
    - path: /var/home/homelab/.config/systemd/user
      user:
        name: homelab
      group:
        name: homelab
    # Declared with the user, or Ignition creates them as root while linking units
    - path: /var/home/homelab/.config/systemd/user/default.target.wants
      user:
        name: homelab
      group:
        name: homelab
    - path: /var/home/homelab/.config/systemd/user/timers.target.wants
      user:
        name: homelab
      group:
        name: homelab
    - path: /var/home/homelab/.config/systemd/user/podman.service.d
      user:
        name: homelab
      group:
        name: homelab

    # Ignition creates implicit parents as root; declare the whole local tree.
    - path: /var/home/homelab/.local
      mode: 0755
      user:
        name: homelab
      group:
        name: homelab
    - path: /var/home/homelab/.local/bin
      mode: 0755
      user:
        name: homelab
      group:
        name: homelab
    - path: /var/home/homelab/.local/state
      mode: 0700
      user:
        name: homelab
      group:
        name: homelab
    - path: /var/home/homelab/.local/state/homelab
      mode: 0700
      user:
        name: homelab
      group:
        name: homelab

  links:
    # Enable Podman socket for Traefik
    - path: /var/home/homelab/.config/systemd/user/timers.target.wants/podman.socket
      target: /usr/lib/systemd/user/podman.socket
      user:
        name: homelab
      group:
        name: homelab

    # Enable Podman auto updates
    - path: /var/home/homelab/.config/systemd/user/timers.target.wants/podman-auto-update.timer
      target: /usr/lib/systemd/user/podman-auto-update.timer
      user:
        name: homelab
      group:
        name: homelab

    # Hometown timezone
    - path: /etc/localtime
      target: ../usr/share/zoneinfo/Europe/Belgrade

    # Enable systemd_exporter
    - path: /var/home/homelab/.config/systemd/user/default.target.wants/systemd-exporter.service
      target: /var/home/homelab/.config/systemd/user/systemd-exporter.service
      user:
        name: homelab
      group:
        name: homelab

    # Enable node_exporter
    - path: /var/home/homelab/.config/systemd/user/default.target.wants/node-exporter.service
      target: /var/home/homelab/.config/systemd/user/node-exporter.service
      user:
        name: homelab
      group:
        name: homelab

  files:
    # Fixed, non-overlapping rootless container ID ranges.
    - path: /etc/subuid
      overwrite: true
      mode: 0644
      contents:
        inline: |
          homelab:524288:65536
          core:655360:65536
    - path: /etc/subgid
      overwrite: true
      mode: 0644
      contents:
        inline: |
          homelab:524288:65536
          core:655360:65536

    # Podman storage for homelab.
    - path: /var/home/homelab/.config/containers/storage.conf
      user:
        name: homelab
      group:
        name: homelab
      contents:
        inline: |
          [storage]
          driver = "overlay"
          graphroot = "/mnt/docker/homelab"

    - path: /etc/containers/storage.conf
      contents:
        inline: |
          [storage]
          driver = "overlay"
          rootless_storage_path = "/var/mnt/docker/$USER"

    # Enable linger so containers can continue to run even after homelab user logouts
    - path: /var/lib/systemd/linger/homelab

    # Set machine hostname
    - path: /etc/hostname
      contents:
        inline: ${hostname}

    # Import Step CA root certificate
    - path: /etc/pki/ca-trust/source/anchors/step-online-ca.pem
      contents:
        inline: |
          ${indent(10, root_ca)}

    # Enable zram swap
    - path: /etc/systemd/zram-generator.conf
      contents:
        inline: |
          [zram0]

    - path: /etc/sysctl.d/90-traefik.conf
      contents:
        inline: |
          net.ipv4.ip_unprivileged_port_start=80

    - path: /etc/sysctl.d/90-bbr.conf
      contents:
        inline: |
          net.core.default_qdisc = cake
          net.ipv4.tcp_congestion_control = bbr

    - path: /etc/sysctl.d/90-inotify.conf
      contents:
        inline: |
          fs.inotify.max_user_instances = 1024

    - path: /etc/ssh/sshd_config.d/20-increase-max-auth-tries.conf
      mode: 0644
      contents:
        inline: |
          # Allow multiple identities offered by SSH agents.
          MaxAuthTries 10

    # Firewall configuration
    - path: /etc/sysconfig/nftables.conf
      overwrite: true
      mode: 0644
      contents:
        inline: |
          include "/etc/nftables/main.nft"

    - path: /etc/nftables/main.nft
      overwrite: true
      mode: 0644
      contents:
        inline: |
          ${indent(10, firewall_config)}

    # download systemd_exporter and create systemd user service
    - path: /var/home/homelab/.local/bin/systemd_exporter.tar.gz
      contents:
        source: https://github.com/prometheus-community/systemd_exporter/releases/download/v0.7.0/systemd_exporter-0.7.0.linux-amd64.tar.gz
        verification:
          hash: sha256-2d995ca20249aeeac8f507173176ce5d162f17470a98ca66e289c85b388480c3
      user:
        name: homelab
      group:
        name: homelab
    - path: /var/home/homelab/.config/systemd/user/systemd-exporter.service
      contents:
        inline: |
          [Unit]
          Description=Systemd Exporter

          [Service]
          Type=simple
          WorkingDirectory=/var/home/homelab/.local/bin
          ExecStartPre=/usr/bin/tar -xf systemd_exporter.tar.gz --strip-components=1 --wildcards '*/systemd_exporter'
          ExecStart=/var/home/homelab/.local/bin/systemd_exporter

          [Install]
          WantedBy=default.target
      user:
        name: homelab
      group:
        name: homelab

    # download node_exporter and create systemd user service
    - path: /var/home/homelab/.local/bin/node_exporter.tar.gz
      contents:
        source: https://github.com/prometheus/node_exporter/releases/download/v1.12.1/node_exporter-1.12.1.linux-amd64.tar.gz
        verification:
          hash: sha256-b51d8a76aa2a9156a55d501aca6276fae09e262259a5e4e831d2c2222f084e63
      user:
        name: homelab
      group:
        name: homelab
    - path: /var/home/homelab/.config/systemd/user/node-exporter.service
      contents:
        inline: |
          [Unit]
          Description=Node Exporter

          [Service]
          Type=simple
          WorkingDirectory=/var/home/homelab/.local/bin
          ExecStartPre=/usr/bin/tar -xf node_exporter.tar.gz --strip-components=1 --wildcards '*/node_exporter'
          ExecStart=/var/home/homelab/.local/bin/node_exporter --collector.systemd --collector.processes

          [Install]
          WantedBy=default.target

    # Disable Podman access logs
    - path: /var/home/homelab/.config/systemd/user/podman.service.d/override.conf
      contents:
        inline: |
          [Service]
          Environment=LOGGING="--log-level=warn"

systemd:
  units:
    - name: install-additional-software.service
      enabled: true
      contents: |
        [Unit]
        Description=Additional software installer
        Wants=network-online.target
        After=network-online.target
        Before=zincati.service
        ConditionPathExists=!/var/lib/%N.stamp

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/usr/bin/rpm-ostree install --allow-inactive --assumeyes --reboot qemu-guest-agent btop nvtop
        ExecStart=/bin/touch /var/lib/%N.stamp

        [Install]
        WantedBy=multi-user.target

    - name: attach-local-disk.service
      enabled: true
      contents: |
        [Unit]
        Description=Activate existing homelab data disk via VirtIO SCSI
        DefaultDependencies=no
        After=systemd-udev-trigger.service
        Before=var-mnt-docker.mount local-fs.target shutdown.target
        Conflicts=shutdown.target

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/usr/bin/udevadm wait --timeout=60 /dev/disk/by-id/lvm-pv-uuid-${data_pv_uuid}
        ExecStart=/usr/sbin/lvmdevices --adddev /dev/disk/by-id/lvm-pv-uuid-${data_pv_uuid}
        ExecStart=/usr/sbin/vgchange -ay vg0

        [Install]
        WantedBy=local-fs.target

    - name: var-mnt-docker.mount
      enabled: true
      contents: |
        [Unit]
        Description=Mount existing homelab data via VirtIO SCSI
        Requires=attach-local-disk.service
        After=attach-local-disk.service
        Before=local-fs.target

        [Mount]
        What=/dev/vg0/lv0
        Where=/var/mnt/docker
        Type=xfs
        Options=defaults

        [Install]
        WantedBy=local-fs.target

    - name: user@1000.service
      dropins:
        - name: 90-storage.conf
          contents: |
            [Unit]
            RequiresMountsFor=/var/mnt/docker /var/mnt/personal /var/mnt/media /var/mnt/observability /var/mnt/random

            [Service]
            ExecStartPre=/usr/bin/mountpoint -q /var/mnt/docker
            ExecStartPre=/usr/bin/mountpoint -q /var/mnt/personal
            ExecStartPre=/usr/bin/mountpoint -q /var/mnt/media
            ExecStartPre=/usr/bin/mountpoint -q /var/mnt/observability
            ExecStartPre=/usr/bin/mountpoint -q /var/mnt/random

    - name: podman-fix-selinux-context.service
      enabled: true
      contents: |
        [Unit]
        Description=Fix SELinux context for Podman storage
        Requires=var-mnt-docker.mount
        After=var-mnt-docker.mount
        ConditionPathExists=!/var/lib/%N.stamp

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/usr/bin/chcon -R -t container_file_t /var/mnt/docker/homelab
        ExecStart=/bin/touch /var/lib/%N.stamp

        [Install]
        WantedBy=multi-user.target

    - name: var-mnt-random.mount
      enabled: true
      contents: |
        [Unit]
        Description=Mount random dataset from PVE via VirtIO-FS
        Before=local-fs.target

        [Mount]
        What=homelab-random
        Where=/var/mnt/random
        Type=virtiofs
        Options=relatime,context=system_u:object_r:container_file_t:s0

        [Install]
        WantedBy=local-fs.target

    - name: var-mnt-observability.mount
      enabled: true
      contents: |
        [Unit]
        Description=Mount observability dataset from PVE via VirtIO-FS
        Before=local-fs.target

        [Mount]
        What=homelab-observability
        Where=/var/mnt/observability
        Type=virtiofs
        Options=relatime,context=system_u:object_r:container_file_t:s0

        [Install]
        WantedBy=local-fs.target

    - name: var-mnt-media.mount
      enabled: true
      contents: |
        [Unit]
        Description=Mount media dataset from PVE via VirtIO-FS
        Before=local-fs.target

        [Mount]
        What=homelab-media
        Where=/var/mnt/media
        Type=virtiofs
        Options=relatime,context=system_u:object_r:container_file_t:s0

        [Install]
        WantedBy=local-fs.target

    - name: var-mnt-personal.mount
      enabled: true
      contents: |
        [Unit]
        Description=Mount personal dataset from PVE via VirtIO-FS
        Before=local-fs.target

        [Mount]
        What=homelab-personal
        Where=/var/mnt/personal
        Type=virtiofs
        Options=relatime,context=system_u:object_r:container_file_t:s0

        [Install]
        WantedBy=local-fs.target

    - name: nftables.service
      enabled: true

    - name: blog-deploy-target.service
      enabled: true
      contents: |
        [Unit]
        Description=Prepare the blog deploy target
        RequiresMountsFor=/var/mnt/docker
        Before=multi-user.target

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/usr/bin/mkdir -p /var/mnt/docker/blog
        ExecStart=/usr/bin/chown -R homelab:homelab /var/mnt/docker/blog
        ExecStart=/usr/bin/chmod 0755 /var/mnt/docker/blog
        # New files inherit the context, so rsync output stays readable to the container
        ExecStart=/usr/bin/chcon -R -t container_file_t /var/mnt/docker/blog

        [Install]
        WantedBy=multi-user.target

kernel_arguments:
  should_exist:
    - pcie_aspm.policy=powersupersave ifname=infra:${fcos_mac_address} ip=${fcos_ip}::${gateway_ip}:${subnet_mask}:${hostname}:infra:none:${dns_ip}
